{
  "id": "mxj.examples.bitcrusher",
  "name": "Bit Crusher",
  "version": "1.0.0",
  "author": "MXJ AUDIO",
  "license": "MIT",
  "type": "effect",
  "category": "Distortion",
  "description": "Lo-fi sound: fewer bits and a lower sample rate.",
  "minMxjVersion": "0.6.0",
  "apiVersion": 1,
  "permissions": [],
  "parameters": [
    { "id": "bits",       "name": "Bits",       "type": "number", "min": 2, "max": 16, "default": 8, "unit": "bit", "decimals": 0 },
    { "id": "downsample", "name": "Downsample", "type": "number", "min": 1, "max": 32, "default": 4, "unit": "x", "decimals": 0 },
    { "id": "mix",        "name": "Mix",        "type": "number", "min": 0, "max": 100, "default": 100, "unit": "%", "decimals": 0 }
  ]
}
